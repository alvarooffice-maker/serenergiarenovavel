---
import { WHATSAPP_ORCAMENTO_URL, WHATSAPP_ICON_PATH, whatsappCom } from '../data/site';

interface Props {
  /** Mensagem pré-preenchida do WhatsApp (padrão: pedido de orçamento). */
  mensagem?: string;
}

const { mensagem } = Astro.props;
const href = mensagem ? whatsappCom(mensagem) : WHATSAPP_ORCAMENTO_URL;
---

<section id="cta-band">
  <div class="cta-box reveal">
    <p class="sec-eyebrow">Fale com um especialista</p>
    <h2 class="sec-title">Pronto para <em class="cta-highlight">Economizar?</em></h2>
    <p class="sec-sub">Solicite agora uma análise gratuita do seu consumo. Sem compromisso, sem burocracia.</p>
    <a class="btn-primary" href={href} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d={WHATSAPP_ICON_PATH}/></svg>
      <span>Solicitar Orçamento Grátis</span>
    </a>
    <div class="cta-contacts">
      <div class="contact-item">
        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.8 10.72 19.79 19.79 0 01.73 2.1 2 2 0 012.7 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.06 6.06l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        (91) 99356-0305
      </div>
      <div class="contact-item">
        <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        serenergiarenovavel.pa@gmail.com
      </div>
      <div class="contact-item">
        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Belém/PA e região
      </div>
    </div>
  </div>
</section>

<style>
  #cta-band {
    padding: 90px 24px;
    text-align:center;
  }
  .cta-box {
    max-width:780px; margin:0 auto;
    padding:64px 48px;
    border:1px solid rgba(155,89,208,0.35);
    border-radius:12px;
    background:
      radial-gradient(ellipse 70% 80% at 50% 50%, rgba(107,47,160,0.2) 0%, transparent 70%),
      rgba(19,8,37,0.8);
    position:relative; overflow:hidden;
  }
  .cta-box::before {
    content:''; position:absolute; top:-1px; left:10%; right:10%; height:1px;
    background:linear-gradient(to right,transparent,rgba(192,132,252,0.7),transparent);
  }
  .cta-box::after {
    content:''; position:absolute; bottom:-1px; left:10%; right:10%; height:1px;
    background:linear-gradient(to right,transparent,rgba(155,89,208,0.4),transparent);
  }
  .cta-box .sec-title { margin-bottom:16px; }
  .cta-box .sec-sub { margin-bottom:40px; }
  .cta-highlight {
    font-style:normal;
    background:linear-gradient(135deg,#d0a0ff,#f0d0ff);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
  }
  .cta-contacts {
    margin-top:36px;
    display:flex; flex-wrap:wrap; gap:20px; justify-content:center;
  }
  .contact-item {
    display:flex; align-items:center; gap:10px;
    font-family:'Rajdhani',sans-serif;
    font-size:0.9rem; font-weight:600;
    letter-spacing:0.1em;
    color:rgba(200,200,224,0.7);
  }
  .contact-item svg { width:18px; height:18px; stroke:var(--purple-glow); fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }

  @media(max-width:640px){
    .cta-box { padding:40px 24px; }
  }
</style>
