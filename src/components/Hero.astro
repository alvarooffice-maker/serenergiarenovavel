---
import { Image } from 'astro:assets';
import logo from '../assets/ser_logo.jpg';
import { WHATSAPP_ORCAMENTO_URL, WHATSAPP_ICON_PATH } from '../data/site';
---

<section id="hero">
  <div class="hero-logo">
    <Image src={logo} alt="SER Energia Renovável" width={220} densities={[1, 2]} loading="eager" fetchpriority="high" />
  </div>
  <p class="hero-eyebrow">Energia solar de ponta a ponta no Pará</p>
  <h1 class="hero-h1">Reduza sua<br><em>conta de luz</em><br>até 85%</h1>
  <p class="hero-sub">
    Da consultoria à homologação, cuidamos de tudo. Energia solar para
    residências, empresas e propriedades rurais em todo o Pará.
  </p>
  <div class="hero-badges">
    <div class="badge">
      <svg class="badge-icon" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      +500 Sistemas Instalados
    </div>
    <div class="badge">
      <svg class="badge-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      Homologação por nossa conta
    </div>
    <div class="badge">
      <svg class="badge-icon" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      +3 Anos de Mercado
    </div>
  </div>
  <div class="hero-btns">
    <a class="btn-primary" href={WHATSAPP_ORCAMENTO_URL} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24"><path d={WHATSAPP_ICON_PATH}/></svg>
      <span>Solicitar Orçamento Grátis</span>
    </a>
    <a class="btn-secondary" href="#simulador">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 8 16 12 12 16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      Simular Economia
    </a>
  </div>
  <div class="scroll-hint">
    <span>Role para saber mais</span>
    <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </div>
</section>

<style>
  #hero {
    min-height: 100vh;
    display:flex; flex-direction:column;
    align-items:center; justify-content:center;
    text-align:center;
    padding: 120px 24px 80px;
  }

  .hero-logo {
    opacity:0; transform: scale(0.8) translateY(30px);
    animation: heroLogoIn 1.1s cubic-bezier(.2,.9,.4,1.2) 0.3s forwards;
  }
  .hero-logo img {
    width: min(220px, 48vw);
    height: auto;
    filter: drop-shadow(0 0 50px rgba(155,89,208,0.65))
            drop-shadow(0 0 100px rgba(155,89,208,0.3));
    animation: logoPulse 4s ease-in-out 1.5s infinite;
  }
  @keyframes heroLogoIn { to { opacity:1; transform:scale(1) translateY(0); } }
  @keyframes logoPulse {
    0%,100% { filter: drop-shadow(0 0 50px rgba(155,89,208,0.65)) drop-shadow(0 0 100px rgba(155,89,208,0.3)); }
    50%      { filter: drop-shadow(0 0 70px rgba(192,132,252,0.9)) drop-shadow(0 0 130px rgba(155,89,208,0.5)); }
  }

  .hero-eyebrow {
    margin-top: 36px;
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(0.75rem, 2vw, 0.9rem);
    font-weight: 600; letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--purple-glow);
    opacity:0; animation: fadeUp 0.9s ease 1s forwards;
  }

  .hero-h1 {
    margin-top: 16px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.8rem, 9vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: 0.03em;
    color: var(--silver-bright);
    text-shadow: 0 0 80px rgba(192,132,252,0.4);
    opacity:0; animation: fadeUp 0.9s ease 1.2s forwards;
  }
  .hero-h1 em {
    font-style:normal;
    background: linear-gradient(135deg, #d0a0ff, #f0d0ff, #c084fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    margin-top: 22px;
    max-width: 560px;
    font-size: clamp(0.95rem, 2.2vw, 1.1rem);
    font-weight: 300;
    line-height: 1.75;
    color: rgba(200,200,224,0.8);
    opacity:0; animation: fadeUp 0.9s ease 1.5s forwards;
  }

  .hero-badges {
    margin-top: 36px;
    display:flex; flex-wrap:wrap; gap:12px; justify-content:center;
    opacity:0; animation: fadeUp 0.9s ease 1.7s forwards;
  }
  .badge {
    display:flex; align-items:center; gap:8px;
    padding: 9px 18px;
    border-radius:40px;
    border: 1px solid rgba(155,89,208,0.4);
    background: rgba(107,47,160,0.15);
    font-family:'Rajdhani',sans-serif;
    font-size:0.85rem; font-weight:600;
    letter-spacing:0.1em; text-transform:uppercase;
    color: rgba(220,210,240,0.9);
  }
  .badge-icon { width:16px; height:16px; stroke:var(--purple-glow); fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }

  .hero-btns {
    margin-top: 48px;
    display:flex; flex-wrap:wrap; gap:16px; justify-content:center;
    opacity:0; animation: fadeUp 0.9s ease 1.9s forwards;
  }

  /* scroll hint */
  .scroll-hint {
    margin-top:60px;
    display:flex; flex-direction:column; align-items:center; gap:8px;
    opacity:0; animation: fadeIn 1s ease 2.5s forwards;
    color: rgba(155,89,208,0.5);
    font-family:'Rajdhani',sans-serif; font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase;
  }
  .scroll-hint .arrow { animation: arrowBounce 1.5s ease-in-out infinite; }
  @keyframes arrowBounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(6px)} }

  @media(max-width:640px){
    .hero-btns { flex-direction:column; align-items:center; }
  }
</style>
