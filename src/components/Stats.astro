---
const stats = [
  { num: '+500', label: 'Sistemas Instalados' },
  { num: '+3', label: 'Anos de Mercado' },
  { num: '85%', label: 'Redução na Conta' },
  { num: '100%', label: 'Homologação por nossa conta' },
];
---

<section id="stats">
  <div class="stats-grid">
    {stats.map((s, i) => (
      <div class:list={['stat-card', 'reveal', i > 0 && `reveal-delay-${i}`]}>
        <div class="stat-num">{s.num}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<style>
  #stats {
    padding: 70px 24px;
  }
  .stats-grid {
    max-width:900px; margin:0 auto;
    display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow:hidden;
    background: var(--border);
  }
  .stat-card {
    padding: 40px 32px;
    background: rgba(19,8,37,0.85);
    text-align:center;
    transition: background 0.3s;
  }
  .stat-card:hover { background: rgba(107,47,160,0.15); }
  .stat-num {
    font-family:'Bebas Neue',sans-serif;
    font-size: clamp(3rem, 7vw, 4.5rem);
    line-height:1;
    background: linear-gradient(135deg, #d0a0ff, #f0e0ff);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
    background-clip:text;
  }
  .stat-label {
    margin-top:10px;
    font-family:'Rajdhani',sans-serif;
    font-size:0.85rem; font-weight:600;
    letter-spacing:0.18em; text-transform:uppercase;
    color: rgba(192,132,252,0.7);
  }
</style>
