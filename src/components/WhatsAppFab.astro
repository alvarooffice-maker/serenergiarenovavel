---
import { WHATSAPP_URL, WHATSAPP_ICON_PATH } from '../data/site';
---

<a class="wha-fab" href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="WhatsApp">
  <div class="wha-fab-pulse"></div>
  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d={WHATSAPP_ICON_PATH}/></svg>
</a>

<style>
  .wha-fab {
    position:fixed; bottom:28px; right:28px; z-index:200;
    width:60px; height:60px; border-radius:50%;
    background:linear-gradient(135deg,#25d366,#128c7e);
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 8px 30px rgba(37,211,102,0.45);
    transition:all 0.3s;
    text-decoration:none;
  }
  .wha-fab:hover { transform:scale(1.1); box-shadow:0 12px 40px rgba(37,211,102,0.65); }
  .wha-fab svg { width:30px; height:30px; fill:white; }
  .wha-fab-pulse {
    position:absolute; inset:-6px; border-radius:50%;
    border:2px solid rgba(37,211,102,0.4);
    animation:whaFabPulse 2s ease-out infinite;
  }
  @keyframes whaFabPulse {
    0%  { transform:scale(1);   opacity:0.8; }
    100%{ transform:scale(1.5); opacity:0; }
  }
</style>
