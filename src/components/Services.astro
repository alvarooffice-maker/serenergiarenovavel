---
import { PRODUTOS } from '../data/produtos';
---

<section id="servicos">
  <div class="sec-header reveal">
    <p class="sec-eyebrow">O que oferecemos</p>
    <h2 class="sec-title">Soluções Completas<br>em Energia Solar</h2>
    <p class="sec-sub">Do projeto à homologação junto à distribuidora, entregamos tudo pronto para você economizar.</p>
  </div>
  <div class="services-grid">
    {PRODUTOS.map((s, i) => (
      <a href={`/solucoes/${s.slug}/`} class:list={['service-card', 'reveal', `reveal-delay-${(i % 3) + 1}`, { 'service-card--wide': i === PRODUTOS.length - 1 }]}>
        <div class="service-icon">
          <svg viewBox="0 0 24 24" set:html={s.icone} />
        </div>
        <div class="service-title">{s.titulo}</div>
        <div class="service-desc">{s.resumo}</div>
        <div class="service-more">Saiba mais <span aria-hidden="true">→</span></div>
      </a>
    ))}
  </div>
</section>

<style>
  #servicos { padding: 90px 24px; }
  .services-grid {
    max-width: 1080px; margin:0 auto;
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .service-card {
    padding: 36px 30px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(19,8,37,0.7);
    transition: all 0.3s;
    position:relative; overflow:hidden;
    display:block; text-decoration:none; color:inherit;
  }
  .service-card--wide { grid-column: 1 / -1; max-width:500px; margin:0 auto; width:100%; }
  .service-card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:2px;
    background: linear-gradient(to right, transparent, var(--purple-bright), transparent);
    opacity:0; transition:opacity 0.3s;
  }
  .service-card:hover { border-color: rgba(155,89,208,0.5); background:rgba(107,47,160,0.12); transform:translateY(-4px); box-shadow:0 20px 50px rgba(75,26,138,0.3); }
  .service-card:hover::before { opacity:1; }
  .service-icon {
    width:52px; height:52px;
    border-radius:12px;
    background: linear-gradient(135deg, rgba(107,47,160,0.4), rgba(75,26,138,0.2));
    border: 1px solid rgba(155,89,208,0.3);
    display:flex; align-items:center; justify-content:center;
    margin-bottom:22px;
  }
  .service-icon svg { width:26px; height:26px; stroke:var(--purple-glow); fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .service-title {
    font-family:'Rajdhani',sans-serif;
    font-size:1.15rem; font-weight:700;
    letter-spacing:0.08em; text-transform:uppercase;
    color:var(--silver-bright); margin-bottom:10px;
  }
  .service-desc {
    font-size:0.9rem; font-weight:300; line-height:1.65;
    color:rgba(200,200,224,0.65);
  }
  .service-more {
    margin-top:18px;
    font-family:'Rajdhani',sans-serif; font-size:0.82rem; font-weight:700;
    letter-spacing:0.15em; text-transform:uppercase;
    color:var(--purple-glow);
  }
  .service-more span { display:inline-block; transition:transform 0.3s; }
  .service-card:hover .service-more span { transform:translateX(4px); }
</style>
